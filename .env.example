# ShipSafe - optional server configuration
PORT=3000

# GitHub REST requests can fetch public repositories without auth, but are
# more heavily rate-limited. Set a server-only token to increase the quota.
# Do not commit a real token or expose it through NEXT_PUBLIC_*.
GITHUB_TOKEN=

# Real public scans require outbound HTTPS to GitHub API, GitHub raw content
# and OSV.dev. Private GitHub App authorization is not yet configured.
