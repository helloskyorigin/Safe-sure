# Secuvora server-side configuration. NEVER commit real secret values.
PORT=3000
SHIPSAFE_PUBLIC_ORIGIN=https://your-secuvora-domain.example

# Optional for unauthenticated *public* Github API read limits only:
GITHUB_TOKEN=

# Register a GitHub App: permission Repository Contents = Read-only,
# Metadata = Read-only. Set OAuth callback to:
# https://your-secuvora-domain.example/api/auth/github/callback
# Enable user-to-server authentication.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# GitHub App URL slug (public; used to show an installation link):
NEXT_PUBLIC_GITHUB_APP_SLUG=

# Generate an independent >=32-character high-entropy random secret.
# Used for AES-GCM authenticated-encryption of HttpOnly user sessions AND
# server-side durable report values. Keep persistent; rotating it invalidates
# existing sessions and reports.
SHIPSAFE_SESSION_SECRET=

# Upstash Redis HTTPS REST database (standard read/write token), server-only:
# Required for private scans, durable 7-day reports and shared scan quotas.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# All deployment values must be entered in the hosting provider's secret
# settings. Never add NEXT_PUBLIC_ to any secret/token above.
